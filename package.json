{
  "name": "luxemarket-shopify-theme",
  "version": "1.0.0",
  "private": true,
  "description": "LuxeMarket \u2013 Premium e-commerce Shopify theme",
  "scripts": {
    "dev": "shopify theme dev --port 9293",
    "pull": "shopify theme pull",
    "push": "shopify theme push",
    "check": "shopify theme check",
    "zip": "python3 scripts/package-theme.py",
    "start:api": "node --env-file-if-exists=.env server/index.cjs",
    "test:api": "node --test server/*.test.cjs"
  },
  "devDependencies": {
    "@shopify/cli": "3.88.1"
  },
  "engines": {
    "node": ">=24"
  }
}
